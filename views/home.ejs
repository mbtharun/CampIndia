<% layout('layouts/boilerplate') %>

    <section class="ci-hero" aria-labelledby="hero-title">
        <div class="ci-hero-media" aria-hidden="true"></div>

        <div class="ci-hero-inner">
            <p class="ci-hero-eyebrow">India's camping community</p>
            <h1 class="ci-hero-title" id="hero-title">Find the quiet places<br>worth remembering.</h1>
            <p class="ci-hero-copy">
                Campgrounds from the Himalayas to the Western Ghats and the coast — mapped, reviewed and
                shared by the travellers who camp there.
            </p>
            <div class="ci-hero-actions">
                <a class="btn-ci-primary btn-ci-lg" href="/campgrounds">Explore campgrounds</a>
                <% if (!currentUser) { %>
                    <a class="btn-ci-ghost btn-ci-lg" href="/register">Join CampIndia</a>
                    <% } else { %>
                        <a class="btn-ci-ghost btn-ci-lg" href="/campgrounds/new">Share a campground</a>
                        <% } %>
            </div>
        </div>
    </section>

    <section class="ci-pillars" aria-label="How CampIndia works">
        <div class="ci-pillar">
            <span class="ci-pillar-icon" aria-hidden="true">🗺️</span>
            <h2 class="ci-pillar-title">Find a place</h2>
            <p class="ci-pillar-text">Browse the map or the listings to see where other campers have pitched.</p>
        </div>
        <div class="ci-pillar">
            <span class="ci-pillar-icon" aria-hidden="true">⛺</span>
            <h2 class="ci-pillar-title">Read the details</h2>
            <p class="ci-pillar-text">Nightly price, exact location and honest star ratings, before you commit.</p>
        </div>
        <div class="ci-pillar">
            <span class="ci-pillar-icon" aria-hidden="true">✍️</span>
            <h2 class="ci-pillar-title">Share your own</h2>
            <p class="ci-pillar-text">Add a campground you love and help the next traveller find it.</p>
        </div>
    </section>