<% layout('layouts/boilerplate')%>
<div class="row justify-content-center animate-in">
    <div class="col-lg-7 col-md-9">
        <div class="ci-page-header text-center">
            <h1>Edit campground</h1>
            <p>Updating the listing for <%= campground.title %></p>
        </div>
        <div class="ci-form-card">
            <form action="/campgrounds/<%= campground._id %>?_method=PUT" method="POST" novalidate
                class="validated-form" enctype="multipart/form-data">
                <div class="form-field mb-3">
                    <label class="form-label" for="title">Title</label>
                    <input class="form-control" type="text" id="title" name="campground[title]"
                        value="<%= campground.title %>" required aria-describedby="title-error">
                    <div class="invalid-feedback" id="title-error">Please give the campground a title.</div>
                </div>

                <div class="form-field mb-3">
                    <label class="form-label" for="location">Location</label>
                    <input class="form-control" type="text" id="location" name="campground[location]"
                        value="<%= campground.location %>" required aria-describedby="location-hint location-error">
                    <p class="ci-field-hint" id="location-hint">Changing this moves the pin on the map.</p>
                    <div class="invalid-feedback" id="location-error">Please enter a location.</div>
                </div>

                <div class="form-field mb-3">
                    <label class="form-label" for="price">Price per night</label>
                    <div class="input-group">
                        <span class="input-group-text" aria-hidden="true">₹</span>
                        <input class="form-control" type="number" id="price" name="campground[price]" min="0"
                            step="0.01" inputmode="decimal" value="<%= campground.price %>" required
                            aria-describedby="price-error">
                    </div>
                    <div class="invalid-feedback" id="price-error">Please enter a nightly price of 0 or more.</div>
                </div>

                <div class="form-field mb-3">
                    <label class="form-label" for="description">Description</label>
                    <textarea class="form-control" id="description" name="campground[description]" required rows="4"
                        aria-describedby="description-error"><%= campground.description %></textarea>
                    <div class="invalid-feedback" id="description-error">Please describe the campground.</div>
                </div>

                <div class="form-field mb-3">
                    <span class="form-label" id="images-label">Add more images</span>
                    <input class="ci-file-input" type="file" id="image" name="image" multiple accept="image/*"
                        aria-labelledby="images-label" data-file-label="file-label-text">
                    <label class="ci-file-upload" for="image">
                        <span class="upload-icon" aria-hidden="true">📸</span>
                        <span class="ci-file-upload-title" id="file-label-text">Choose photos</span>
                        <span class="ci-file-upload-hint">JPG, PNG or WEBP — you can select several</span>
                    </label>
                </div>

                <% if (campground.images.length) { %>
                <div class="form-field mb-3">
                    <span class="form-label">Current images</span>
                    <p class="ci-field-hint">Tick the box on a photo to delete it when you save.</p>
                    <div class="edit-thumbnails">
                        <% campground.images.forEach(function (img, i) { %>
                        <div class="edit-thumbnail-item">
                            <img src="<%= img.thumbnail %>" alt="Photo <%= i + 1 %> of <%= campground.title %>">
                            <div class="delete-check">
                                <input type="checkbox" class="form-check-input" id="image-<%= i %>"
                                    name="deleteImages[]" value="<%= img.filename %>">
                            </div>
                            <label class="delete-label" for="image-<%= i %>">Delete</label>
                        </div>
                        <% }) %>
                    </div>
                </div>
                <% } %>

                <div class="d-grid">
                    <button class="btn-ci-warning btn-ci-lg" type="submit">Save changes</button>
                </div>
            </form>

            <div class="text-center">
                <a href="/campgrounds/<%= campground._id %>" class="ci-back-link">← Back to campground</a>
            </div>
        </div>
    </div>
</div>
