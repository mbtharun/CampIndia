<% layout('layouts/boilerplate')%>
<div class="row justify-content-center animate-in">
    <div class="col-lg-7 col-md-9">
        <div class="ci-page-header text-center">
            <h1>New campground</h1>
            <p>Add a place you have camped and help the next traveller find it.</p>
        </div>
        <div class="ci-form-card">
            <form action="/campgrounds" method="POST" novalidate class="validated-form" enctype="multipart/form-data">
                <div class="form-field mb-3">
                    <label class="form-label" for="title">Title</label>
                    <input class="form-control" type="text" id="title" name="campground[title]" required
                        placeholder="e.g. Sunset Valley Camp" aria-describedby="title-error">
                    <div class="invalid-feedback" id="title-error">Please give the campground a title.</div>
                </div>

                <div class="form-field mb-3">
                    <label class="form-label" for="location">Location</label>
                    <input class="form-control" type="text" id="location" name="campground[location]" required
                        placeholder="e.g. Manali, Himachal Pradesh" aria-describedby="location-hint location-error">
                    <p class="ci-field-hint" id="location-hint">A city or region name — we use it to place the pin on the map.</p>
                    <div class="invalid-feedback" id="location-error">Please enter a location.</div>
                </div>

                <div class="form-field mb-3">
                    <label class="form-label" for="price">Price per night</label>
                    <div class="input-group">
                        <span class="input-group-text" aria-hidden="true">₹</span>
                        <input class="form-control" type="number" id="price" name="campground[price]" min="0"
                            step="0.01" inputmode="decimal" placeholder="0.00" required
                            aria-describedby="price-error">
                    </div>
                    <div class="invalid-feedback" id="price-error">Please enter a nightly price of 0 or more.</div>
                </div>

                <div class="form-field mb-3">
                    <label class="form-label" for="description">Description</label>
                    <textarea class="form-control" id="description" name="campground[description]" required rows="4"
                        placeholder="What is the ground like? Water, shade, access?"
                        aria-describedby="description-error"></textarea>
                    <div class="invalid-feedback" id="description-error">Please describe the campground.</div>
                </div>

                <div class="form-field mb-4">
                    <span class="form-label" id="images-label">Images</span>
                    <input class="ci-file-input" type="file" id="image" name="image" multiple accept="image/*"
                        aria-labelledby="images-label" data-file-label="file-label-text">
                    <label class="ci-file-upload" for="image">
                        <span class="upload-icon" aria-hidden="true">📸</span>
                        <span class="ci-file-upload-title" id="file-label-text">Choose photos</span>
                        <span class="ci-file-upload-hint">JPG, PNG or WEBP — you can select several</span>
                    </label>
                </div>

                <div class="d-grid">
                    <button class="btn-ci-success btn-ci-lg" type="submit">Add campground</button>
                </div>
            </form>

            <div class="text-center">
                <a href="/campgrounds" class="ci-back-link">← All campgrounds</a>
            </div>
        </div>
    </div>
</div>
