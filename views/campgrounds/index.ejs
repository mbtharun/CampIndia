<% layout('layouts/boilerplate')%>

    <div class="ci-page-header">
        <h1>All campgrounds</h1>
        <p>Every campground here was added by a member of the CampIndia community. Pick a pin or a card to see the
            details.</p>
    </div>

    <div id="cluster-map" role="region" aria-label="Map of campgrounds across India"></div>

    <% if (!campgrounds.length) { %>
        <div class="ci-empty-state">
            <p class="mb-3">No campgrounds have been added yet.</p>
            <% if (currentUser) { %>
                <a class="btn-ci-primary" href="/campgrounds/new">Add the first campground</a>
                <% } else { %>
                    <a class="btn-ci-primary" href="/register">Join to add the first campground</a>
                    <% } %>
        </div>
        <% } %>

            <% for (let campground of campgrounds) { %>
                <div class="ci-card campground-card animate-in">
                    <div class="row g-0">
                        <div class="col-md-4">
                            <div class="card-img-wrapper">
                                <% if (campground.images.length) { %>
                                    <img src="<%= campground.images[0].url %>" alt="Photo of <%= campground.title %>">
                                    <% } else { %>
                                        <img src="/images/campground-placeholder.svg"
                                            alt="No photos added for <%= campground.title %> yet">
                                        <% } %>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="card-body d-flex flex-column h-100">
                                <h2 class="card-title">
                                    <%= campground.title %>
                                </h2>
                                <p class="card-text flex-grow-1">
                                    <%= campground.description %>
                                </p>
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
                                    <span class="card-location">
                                        <span aria-hidden="true">📍</span>
                                        <%= campground.location %>
                                    </span>
                                    <a class="btn-ci-primary" href="/campgrounds/<%= campground._id %>">
                                        View details
                                        <span aria-hidden="true">→</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>

                    <script>
                        const mapToken = '<%- process.env.MAPBOX_TOKEN %>';
                        const campgrounds = { features: <%- JSON.stringify(campgrounds) %> }
                    </script>

                    <script src="/javascripts/clusterMap.js"></script>