<% layout('layouts/boilerplate')%>

    <div class="row justify-content-center animate-in">
        <div class="col-lg-7 col-md-9">
            <div class="ci-error-card">
                <div class="error-icon" aria-hidden="true">⛺</div>
                <h1>
                    <%= err.message %>
                </h1>
                <p class="text-ci-muted">
                    That trail did not lead anywhere. Head back to safety and try again.
                </p>
                <a href="/" class="btn-ci-primary mt-2">Back to the homepage</a>
                <% if (process.env.NODE_ENV !=="production" ) { %>
                    <pre aria-label="Error details"><%= err.stack %></pre>
                    <% } %>
            </div>
        </div>
    </div>