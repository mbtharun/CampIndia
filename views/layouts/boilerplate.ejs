<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="CampIndia — Discover and share the best campgrounds across India">
    <title>CampIndia — Discover India's Best Campgrounds</title>

    <link rel="icon" type="image/png" href="/img.png">

    <!-- Google Fonts: Fraunces (display) + Inter (text) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet">




    <!-- Bootstrap 5.3.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <!-- Mapbox -->
    <script src='https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js'></script>
    <link href='https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css' rel='stylesheet' />

    <!-- App Styles -->
    <link rel="stylesheet" href="/stylesheets/app.css">

    <% if (typeof pageStyles !=='undefined' && pageStyles) { %>
        <% pageStyles.forEach(function (href) { %>
            <link rel="stylesheet" href="<%= href %>">
            <% }) %>
                <% } %>
</head>

<body class="ci-body">
    <a class="ci-skip-link" href="#main-content">Skip to main content</a>

    <%- include('../partials/navbar')%>

        <main class="container ci-main" id="main-content">
            <%- include('../partials/flash')%>
                <%- body %>
        </main>

        <%- include('../partials/footer')%>

            <!-- Bootstrap 5.3 JS Bundle -->
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
                crossorigin="anonymous"></script>

            <script src='/javascripts/validateForms.js'></script>
</body>

</html>