<div class="ci-flash" aria-live="polite">
    <% if (success && success.length) { %>
        <% success.forEach(function (message) { %>
    <div class="alert ci-alert ci-alert-success alert-dismissible fade show" role="status">
        <span class="ci-alert-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" focusable="false">
                <path d="m9.6 16.2-3.4-3.4 1.4-1.4 2 2 5.8-5.8 1.4 1.4z" fill="currentColor" />
            </svg>
        </span>
        <span class="ci-alert-text"><%= message %></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss message"></button>
    </div>
        <% }) %>
    <% } %>

    <% if (error && error.length) { %>
        <% error.forEach(function (message) { %>
    <div class="alert ci-alert ci-alert-danger alert-dismissible fade show" role="alert">
        <span class="ci-alert-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" focusable="false">
                <path d="M11 7h2v7h-2zm0 9h2v2h-2z" fill="currentColor" />
                <path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 16.2A7.2 7.2 0 1 1 12 4.8a7.2 7.2 0 0 1 0 14.4Z"
                    fill="currentColor" />
            </svg>
        </span>
        <span class="ci-alert-text"><%= message %></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss message"></button>
    </div>
        <% }) %>
    <% } %>
</div>
