<% layout('layouts/boilerplate')%>

    <div class="auth-wrapper">
        <div class="auth-card animate-in">
            <div class="auth-header">
                <h3>Create an account</h3>
                <p>Join the CampIndia community</p>
            </div>
            <div class="auth-body">
                <form action="/register" method="POST" class="validated-form" novalidate>
                    <div class="form-field mb-3">
                        <label class="form-label" for="username">Username</label>
                        <input class="form-control" type="text" id="username" name="username" required autofocus
                            autocapitalize="none" spellcheck="false" autocomplete="username"
                            placeholder="Choose a username" aria-describedby="username-error">
                        <div class="invalid-feedback" id="username-error">Please choose a username.</div>
                    </div>
                    <div class="form-field mb-3">
                        <label class="form-label" for="email">Email</label>
                        <input class="form-control" type="email" id="email" name="email" required autocomplete="email"
                            placeholder="you@example.com" aria-describedby="email-error">
                        <div class="invalid-feedback" id="email-error">Please enter a valid email address.</div>
                    </div>
                    <div class="form-field mb-3">
                        <label class="form-label" for="password">Password</label>
                        <input class="form-control" type="password" id="password" name="password" required
                            autocomplete="new-password" placeholder="Create a password"
                            aria-describedby="password-error">
                        <div class="invalid-feedback" id="password-error">Please create a password.</div>
                    </div>
                    <button class="btn-auth" type="submit">Create account</button>
                </form>
            </div>
            <div class="auth-footer">
                Already have an account? <a href="/login">Sign in</a>
            </div>
        </div>
    </div>